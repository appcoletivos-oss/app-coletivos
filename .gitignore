# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ferramentas de agente/skills (cache local do Claude Code/Cowork — não é
# parte do app, não precisa ir pro controle de versão)
.agents/
.claude/
skills-lock.json

# material de apoio (planilhas reais, wireframes) — fica só na pasta local,
# fora do git, porque algumas planilhas têm nome real de gente da equipe
/Arquivos extras/

claude/
